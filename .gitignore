# --- Secrets & lokale Konfiguration ---
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# --- uv ---
# uv.lock wird bewusst NICHT ignoriert (reproduzierbare Builds)

# --- Node / UI ---
node_modules/
ui/dist/
ui/.vite/
npm-debug.log*

# --- Docker / Daten ---
data/
var/

# --- IDE ---
.idea/
.vscode/
*.swp

# --- OS ---
.DS_Store
Thumbs.db

# --- Eigene Zertifizierungsstellen (opt-in, siehe docker/ca-certificates/README.md) ---
# Ein CA-Zertifikat ist kein Geheimnis, aber die Ausstellerkette eines Unternehmens gehoert
# nicht in ein oeffentliches Repository. Der README bleibt, damit das Verzeichnis fuer den
# COPY im Dockerfile immer existiert.
docker/ca-certificates/*
!docker/ca-certificates/README.md
